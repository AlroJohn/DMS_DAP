  DOCUMENT_SIGNATURE_REMOVED
  DOCUMENT_CHECKED_OUT
  DOCUMENT_CHECKED_IN
  DOCUMENT_TRANSFERRED
  DOCUMENT_TYPE_CHANGED
  DOCUMENT_CLASSIFICATION_CHANGED
  DOCUMENT_STATUS_CHANGED
  DOCUMENT_METADATA_UPDATED
  DOCUMENT_FILE_VERSION_CREATED
  DOCUMENT_FILE_VERSION_DELETED
  DOCUMENT_ACCESS_VIEWED
  DOCUMENT_PERMISSION_CHANGED
  DOCUMENT_DEPARTMENT_CHANGED
  DOCUMENT_TITLE_CHANGED
  DOCUMENT_DESCRIPTION_CHANGED
  DOCUMENT_SECURITY_LEVEL_CHANGED
  DOCUMENT_RETENTION_PERIOD_CHANGED
  DOCUMENT_EXPIRED
  DOCUMENT_AUTO_DELETED
