generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  account_id                 String               @id @default(uuid()) @db.Uuid
  department_id              String?              @db.Uuid
  email                      String               @unique
  password                   String?
  google_provider_id         String?              @unique
  microsoft_provider_id      String?              @unique
  is_active                  Boolean              @default(true)
  email_verified             Boolean              @default(false)
  last_login                 DateTime?
  created_at                 DateTime             @default(now())
  updated_at                 DateTime             @default(now()) @updatedAt
  department                 Department?                   @relation(fields: [department_id], references: [department_id])
  documents_restored         Document[]                    @relation("DocumentRestoredBy")
  document_files             DocumentFile[]                @relation("AccountUploadedFiles")
  document_details_created   DocumentAdditionalDetails[]   @relation("DocumentDetailsCreatedBy")
  password_reset_tokens      PasswordResetToken[]
  permission_audit_performed PermissionAuditLog[] @relation("PermissionAuditPerformedBy")
  roles_created              Role[]               @relation("RoleCreatedBy")
  roles_updated              Role[]               @relation("RoleUpdatedBy")
  role_permissions_granted   RolePermission[]
  saved_searches             SavedSearch[]
  session_logs               SessionLog[]
  user                       User?
  userCheckouts              UserCheckout[]
  UserFeedback               UserFeedback[]
  sent_invitations           UserInvitation[]
  user_permissions_granted   UserPermission[]     @relation("UserPermissionGrantedBy")
  user_role_assignments      UserRole[]           @relation("UserRoleAssignedBy")
  sessions                   UserSession[]
}

model User {
  user_id                    String                     @id @default(uuid()) @db.Uuid
  account_id                 String                     @unique @db.Uuid
  department_id              String                     @db.Uuid
  first_name                 String
  last_name                  String
  middle_name                String?
  user_name                  String?                    @unique
  title                      String?
  type                       String?
  avatar                     String?
  signature                  String?
  active                     Boolean                    @default(true)
  created_at                 DateTime                   @default(now())
  updated_at                 DateTime                   @default(now()) @updatedAt
  document_trails            DocumentTrail[]
  notifications              Notification[]
  notification_subscriptions NotificationSubscription[]
  permission_audit_target    PermissionAuditLog[]       @relation("PermissionAuditTargetUser")
  signed_documents           SignedDocument[]
  account                    Account                    @relation(fields: [account_id], references: [account_id], onDelete: Cascade)
  user_permissions           UserPermission[]
  user_roles                 UserRole[]
  scheduled_reports          ScheduledReport[]
}

model Department {
  department_id String           @id @default(uuid()) @db.Uuid
  name          String
  code          String           @unique
  active        Boolean          @default(true)
  created_at    DateTime         @default(now())
  created_by    String           @db.Uuid
  updated_at    DateTime         @default(now()) @updatedAt
  Account       Account[]
  from_trails   DocumentTrail[]  @relation("FromDepartment")
  to_trails     DocumentTrail[]  @relation("ToDepartment")
  invitations   UserInvitation[]
}

model Document {
  document_id               String                      @id @default(uuid()) @db.Uuid
  title                     String
  description               String?
  document_code             String                      @unique
  document_type             String
  classification            DocClassification           @default(simple)
  origin                    DocOrigin                   @default(external)
  status                    DocStatus                   @default(dispatch)
  created_at                DateTime                    @default(now())
  updated_at                DateTime                    @default(now()) @updatedAt
  deleted_at                DateTime?
  restored_at               DateTime?
  restored_by               String?                     @db.Uuid
  restored_by_account       Account?                    @relation("DocumentRestoredBy", fields: [restored_by], references: [account_id])
  DocumentAdditionalDetails DocumentAdditionalDetails[]
  files                     DocumentFile[]              @relation("DocumentFiles")
  document_trails           DocumentTrail[]
  signature_placeholders    SignaturePlaceholder[]
  signedDocuments           SignedDocument[]
}

model DocumentAdditionalDetails {
  detail_id                   String    @id @default(uuid()) @db.Uuid
  document_id                 String    @db.Uuid
  received_by                 String?   @db.Uuid
  work_flow_id                Json?
  received_by_department_user Json?
  work_flow_status            Json?
  blockchain_project_uuid     String?
  blockchain_tx_hash          String?
  blockchain_status           String?
  blockchain_redirect_url     String?
  signed_at                   DateTime?
  signed_by                   String?   @db.Uuid
  remarks                     String?
  deleted_by                  String?   @db.Uuid
  restored_by                 String?   @db.Uuid
  created_at                  DateTime  @default(now())
  updated_at                  DateTime  @default(now()) @updatedAt
  deleted_at                  DateTime?
  restored_at                 DateTime?
  account_id                  String?   @db.Uuid
  Document                    Document  @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  created_by_account          Account?  @relation("DocumentDetailsCreatedBy", fields: [account_id], references: [account_id])

  @@index([document_id])
  @@index([account_id])
}

model DocumentType {
  type_id     String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt
}

model DocumentAction {
  document_action_id  String                @id @default(uuid()) @db.Uuid
  action_name         String
  description         String?
  sender_tag          String?
  recipient_tag       String?
  status              Boolean               @default(true)
  action_date         DateTime              @default(now())
  created_at          DateTime              @default(now())
  updated_at          DateTime              @default(now()) @updatedAt
  permission_id       String?               @db.Uuid
  required_permission PermissionDefinition? @relation(fields: [permission_id], references: [permission_id])
  document_trails     DocumentTrail[]
}

model DocumentTrail {
  trail_id        String          @id @default(uuid()) @db.Uuid
  document_id     String          @db.Uuid
  action_id       String?         @db.Uuid
  from_department String?         @db.Uuid
  to_department   String?         @db.Uuid
  user_id         String?         @db.Uuid
  action_date     DateTime        @default(now())
  status          String
  remarks         String?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @default(now()) @updatedAt
  documentAction  DocumentAction? @relation(fields: [action_id], references: [document_action_id])
  document        Document        @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  fromDept        Department?     @relation("FromDepartment", fields: [from_department], references: [department_id])
  toDept          Department?     @relation("ToDepartment", fields: [to_department], references: [department_id])
  user            User?           @relation(fields: [user_id], references: [user_id])
}

model DocumentMetadata {
  metadata_id       String        @id @default(uuid()) @db.Uuid
  file_id           String        @unique @db.Uuid
  file_size         BigInt?
  file_type         String?
  mime_type         String?
  author            String?
  creator           String?
  producer          String?
  creation_date     DateTime?
  modification_date DateTime?
  security_level    SecurityLevel @default(public)
  retention_period  Int?
  is_encrypted      Boolean       @default(false)
  checksum          String?
  version           String        @default("1.0")
  created_at        DateTime      @default(now())
  updated_at        DateTime      @default(now()) @updatedAt
  DocumentFile      DocumentFile  @relation(fields: [file_id], references: [file_id], onDelete: Cascade)
}

model DocumentFile {
  checkout               Boolean                @default(false)
  file_id                String                 @id @default(uuid()) @db.Uuid
  document_id            String                 @db.Uuid
  original_name          String
  stored_name            String
  storage_path           String
  file_size              BigInt
  mime_type              String
  checksum               String?
  version                String                 @default("1.0")
  is_primary             Boolean                @default(false)
  uploaded_by            String                 @db.Uuid
  uploaded_at            DateTime               @default(now())
  updated_at             DateTime               @default(now()) @updatedAt
  version_group_id       String?                @db.Uuid
  Document               Document               @relation("DocumentFiles", fields: [document_id], references: [document_id], onDelete: Cascade)
  uploaded_by_account    Account                @relation("AccountUploadedFiles", fields: [uploaded_by], references: [account_id])
  DocumentMetadata       DocumentMetadata?
  signature_placeholders SignaturePlaceholder[]
  signed_documents       SignedDocument[]
  checked_out_by         UserCheckout[]

  @@index([document_id])
  @@index([uploaded_by])
  @@index([version_group_id])
}

model UserCheckout {
  checkout_id            String       @id @default(uuid()) @db.Uuid
  file_id                String       @db.Uuid
  checked_out_at         DateTime     @default(now())
  checked_out_by         String       @db.Uuid
  checked_out_by_account Account      @relation(fields: [checked_out_by], references: [account_id])
  documentFile           DocumentFile @relation(fields: [file_id], references: [file_id])
}

model SignedDocument {
  signed_document_id  String        @id @default(uuid()) @db.Uuid
  document_id         String        @db.Uuid
  signee_id           String        @db.Uuid
  x_position          Float
  y_position          Float
  width               Float
  height              Float
  page_number         Int
  signature_data      String?
  signed_at           DateTime      @default(now())
  created_at          DateTime      @default(now())
  updated_at          DateTime      @default(now()) @updatedAt
  documentFileFile_id String?       @db.Uuid
  documentFile        DocumentFile? @relation(fields: [documentFileFile_id], references: [file_id])
  document            Document      @relation(fields: [document_id], references: [document_id], onDelete: Cascade)
  signee              User          @relation(fields: [signee_id], references: [user_id], onDelete: Cascade)

  @@index([document_id])
  @@index([signee_id])
  @@index([document_id, page_number])
}

model SignaturePlaceholder {
  placeholder_id   String       @id @default(uuid()) @db.Uuid
  document_id      String       @db.Uuid
  document_file_id String       @db.Uuid
  x_position       Float
  y_position       Float
  width            Float
  height           Float
  page_number      Int
  created_at       DateTime     @default(now())
  documentFile     DocumentFile @relation(fields: [document_file_id], references: [file_id], onDelete: Cascade)
  document         Document     @relation(fields: [document_id], references: [document_id], onDelete: Cascade)

  @@index([document_id])
  @@index([document_file_id])
}

