# Printer Configuration for Brother PT-P710BT (USB)

# Socket.IO Server URL
NEXT_PUBLIC_PRINTER_SOCKET_URL=http://localhost:3001

# Printer authentication token (optional)
PRINTER_SOCKET_TOKEN=

# USB Printer Configuration
USE_USB=true
PRINTER_NAME=Brother PT-P710BT

# Network Printer Configuration (if using WiFi/Ethernet instead of USB)
# PRINTER_IP=192.168.1.16
# PRINTER_PORT=9100

# Printer Type
PRINTER_TYPE=PT-P710BT

# Barcode Configuration
BARCODE_FORMAT=CODE128
BARCODE_WIDTH=2
BARCODE_HEIGHT=50
BARCODE_DISPLAY_VALUE=true

# Label Configuration
LABEL_WIDTH=24
AUTO_CUT=true
PRINT_MARGIN=3
