# ========================================
# DMS PRINTER CLIENT CONFIGURATION
# ========================================
# Copy this file to .env and configure for your environment
#
# IMPORTANT FOR CLOUD DEPLOYMENT:
# 1. Change BACKEND_URL to your AWS backend URL
# 2. Set PRINTER_TOKEN if your backend requires authentication
# 3. Verify PRINTER_FILTER matches your printer name
# ========================================

# Backend URL (REQUIRED - Change this for AWS deployment!)
# For local testing: http://localhost:3001
# For AWS deployment: https://your-backend-domain.com
BACKEND_URL=http://localhost:3001

# Printer Authentication Token (Optional)
# This should match the PRINTER_SOCKET_TOKEN in your backend
PRINTER_TOKEN=

# Printer Filter Name (Used to detect your Brother printer)
# The client will auto-detect any printer containing this text
# Common values: "Brother", "PT-P710BT", "Brother PT-P710BT"
PRINTER_FILTER=Brother

# Enable Debug Mode (Shows detailed connection and print logs)
DEBUG=false
