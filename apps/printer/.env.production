# ========================================
# DMS PRINTER CLIENT - PRODUCTION CONFIG
# ========================================
# For AWS Cloud Deployment
# ========================================

# Backend URL - Your AWS Backend
BACKEND_URL=https://your-aws-backend-domain.com

# Printer Authentication Token (Optional but recommended for production)
PRINTER_TOKEN=your-secure-token-here

# Printer Filter Name
PRINTER_FILTER=Brother

# Debug Mode (set to false for production)
DEBUG=false
