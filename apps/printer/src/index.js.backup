const io = require("socket.io-client");
const fs = require("fs");
const path = require("path");
const PDFDocument = require("pdfkit");
const bwipjs = require("bwip-js");
const pdfPrinter = require("pdf-to-printer");
const { execSync } = require("child_process");

// --- Configuration ---
const SOCKET_URL = process.env.NEXT_PUBLIC_PRINTER_SOCKET_URL || "http://localhost:3001";
const PRINTER_FILTER = "Brother"; // Filter to find the Brother printer
const PRINTER_TOKEN = process.env.PRINTER_SOCKET_TOKEN;

// 24mm tape height ~ 68 points (1mm = 2.835 points)
// 100mm length (3.94") x 24mm width (0.94")
const LABEL_HEIGHT_MM = 24; // Exact 24mm
const LABEL_WIDTH_MM = 100; // 3.94 inches
const PRO_MM_TO_PT = 2.83465;

// NB: PAGE_WIDTH and PAGE_HEIGHT are just helpers, but we use explicit width/height in generateLabelPDF now.
const PAGE_WIDTH = LABEL_WIDTH_MM * PRO_MM_TO_PT; // 100mm
const PAGE_HEIGHT = LABEL_HEIGHT_MM * PRO_MM_TO_PT; // 24mm

// Setup Socket
const socket = io(SOCKET_URL, {
  auth: PRINTER_TOKEN ? { token: PRINTER_TOKEN } : { printer: true },
  transports: ["websocket"],
  rejectUnauthorized: false,
});

console.log("Starting Printer Service...");
console.log(`Target Printer Filter: "${PRINTER_FILTER}"`);
console.log(`Socket URL: ${SOCKET_URL}`);

// Helper: Find Brother Printer using Powershell (avoids native dependency issues)
function getBrotherPrinterName() {
  try {
    // Powershell command to list printer names
    const command = 'powershell -Command "Get-Printer | Select-Object -ExpandProperty Name"';
    const stdout = execSync(command, { encoding: 'utf8' });
    const printers = stdout.split(/\r?\n/).map(p => p.trim()).filter(p => p);
    
    // Prioritize PT-P series (Label Printers)
    const labelPrinter = printers.find((p) => p.includes("PT-P") || p.includes("P-touch"));
    if (labelPrinter) return labelPrinter;

    // Fallback to any Brother printer
    const brother = printers.find((p) => p.includes(PRINTER_FILTER));
    return brother || null;
  } catch (err) {
    console.error("⚠️ Failed to list printers via PowerShell:", err.message);
    return null;
  }
}

const detectedPrinter = getBrotherPrinterName();
if (detectedPrinter) {
  console.log(`✅ Detected Brother Printer: "${detectedPrinter}"`);
} else {
  console.warn(`⚠️ No Brother printer found matching "${PRINTER_FILTER}". Check USB connection.`);
}

socket.on("connect", () => {
  console.log("✅ Connected to Socket Server:", socket.id);
  socket.emit("printer:register");
});

socket.on("disconnect", () => console.log("disconnected"));

socket.on("printJob", async (job) => {
  console.log(`Received Print Job: ${job.jobId || 'unknown'}`);
  
  try {
    // Determine content to print
    // Support multiple formats seen in backup
    const requestData = job.data || {};
    const barcodeText = requestData.barcodeData || requestData.documentCode || requestData.text;
    const titleText = "Property of: DAP"; 

    if (!barcodeText) {
      console.error("❌ No barcode data provided in job");
      return;
    }

    console.log(`Generating Label: "${titleText}" - [${barcodeText}]`);

    // 1. Generate PDF Label
    const pdfPath = path.join(__dirname, `temp_label_${Date.now()}.pdf`);
    await generateLabelPDF(pdfPath, titleText, barcodeText);

    // 2. Print
    const printerName = getBrotherPrinterName();
    if (!printerName) {
      throw new Error("Brother printer not found");
    }

    console.log(`🖨️ Printing to "${printerName}"...`);
    
    // Printer options: 
    // "fit-to-page" might distort barcode. 
    // We created PDF at exact 24mm size.
    await pdfPrinter.print(pdfPath, {
        printer: printerName,
        scale: "noscale", 
        orientation: "portrait", // Enforce portrait to match our 24x100 PDF
        paperSize: "24mm", // Hint to driver if possible, though 'noscale' is key
    });

    console.log("✅ Print command sent!");
    
    // Cleanup
    setTimeout(() => {
        try { fs.unlinkSync(pdfPath); } catch(e) {}
    }, 5000);

    // Ack
    socket.emit("printSuccess", {
        jobId: job.jobId,
        status: "completed",
        message: "Label printed successfully"
    });

  } catch (err) {
    console.error("❌ Print Failed:", err);
    socket.emit("printError", {
        jobId: job.jobId,
        error: err.message
    });
  }
});


/**
 * Generates a PDF label with "Property of: DAP" and a Barcode
 */
async function generateLabelPDF(filepath, title, barcodeText) {
  return new Promise((resolve, reject) => {
    // FIX: To prevent "shrinking", we must match the Tape Width (24mm) exactly.
    // We create a "Tall" PDF (24mm Wide x 100mm High).
    // The printer treats Width as the constraint. 
    // We then rotate content 90 degrees so it runs along the Length (100mm).
    
    // Page Dimensions
    const pdfWidth = LABEL_HEIGHT_MM * PRO_MM_TO_PT; // 24mm width
    const pdfHeight = LABEL_WIDTH_MM * PRO_MM_TO_PT; // 100mm height

    const doc = new PDFDocument({
      size: [pdfWidth, pdfHeight],
      margin: 0,
      layout: 'portrait' // Width=24mm, Height=100mm
    });

    const stream = fs.createWriteStream(filepath);
    doc.pipe(stream);

    // --- Coordinate Transformation ---
    // We want (0,0) to be the "Start" of the tape, writing along the length.
    // Translate to Top-Right (24mm, 0) and Rotate 90.
    // New X-axis points DOWN (Along tape length).
    // New Y-axis points LEFT (Across tape width).
    
    doc.save();
    doc.translate(pdfWidth, 0); 
    doc.rotate(90);

    // Conceptually now:
    // Page is 100mm Wide (X), 24mm High (Y)
    // But Y grows "Up" visually in the code relative to current transform? 
    // Let's stick to: draw relative to new axes.
    // X goes 0 -> 100 (Length)
    // Y goes 0 -> 24 (Width)
    
    const DRAW_WIDTH = PAGE_WIDTH; // 100mm
    const DRAW_HEIGHT = PAGE_HEIGHT; // 24mm (Wait, constants were swapped in previous edits?)
    
    // Check Constants from global scope:
    // LABEL_HEIGHT_MM = 23 (Width of tape effectively)
    // LABEL_WIDTH_MM = 100 (Length of label)
    // PAGE_WIDTH = 100 * pt
    // PAGE_HEIGHT = 23 * pt
    
    // 1. Title Text
    doc.fontSize(9);
    doc.font('Helvetica-Bold');
    // x=10 (start offset), y=2 (close to 'top' edge which is the right edge of tape?)
    // Note: With current transform, Y=0 is the Right edge. Y increases towards Left edge.
    // If we want text at Top of tape (Left edge), we need Y to be near 24?
    // Brother output usually: Tape comes out left-to-right.
    // Top of text usually points to "Left" or "Right" of tape depending on look.
    // Let's assume standard reading: Text upright.
    // Usually implies Bottom of text is towards bottom of tape.
    // Let's center it vertically in the strip.
    
    doc.text(title, 10, 2, {
        width: DRAW_WIDTH - 20,
        align: 'left'
    });

    // 2. Barcode
    try {
        const barcodeOptions = {
            bcid: 'code128',
            text: barcodeText,
            scale: 2,             
            height: 10,            // 10mm height
            includetext: true,
            textxalign: 'center', 
            textsize: 9
        };
        
        bwipjs.toBuffer(barcodeOptions, function(err, png) {
            if (err) {
                reject(err);
                return;
            }
            
            try {
                // Place barcode below text
                // Text at y=2. approx height 10pt (~3.5mm).
                // Barcode at y=8?
                
                doc.image(png, 5, 15, {
                    fit: [DRAW_WIDTH - 10, 50], // Width constrained, height ample
                    align: 'center',
                    valign: 'top'
                });
                
                doc.restore();
                doc.end();
            } catch (imgErr) {
                reject(imgErr);
            }
        });

    } catch (e) {
        reject(e);
    }


    stream.on('finish', () => {
        resolve(filepath);
    });

    stream.on('error', (err) => {
        reject(err);
    });
  });
}
