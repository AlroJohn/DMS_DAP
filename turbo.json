{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "apps/backend/dist/**",
        "apps/frontend/.next/**",
        "packages/**/dist/**"
      ],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {},
    "lint": {},
    "clean": {},
    "prisma:generate": {
      "cache": false,
      "outputs": ["apps/backend/prisma/generated/**"]
    },
    "prisma:push": {
      "cache": false
    },
    "prisma:studio": {
      "cache": false,
      "persistent": true
    },
    "prisma:migrate": {
      "cache": false
    },
    "prisma:deploy": {
      "cache": false
    },
    "prisma:reset": {
      "cache": false
    },
    "prisma:seed": {
      "cache": false
    }
  }
}
